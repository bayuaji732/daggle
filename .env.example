# Daggle - Environment Variables Template
# Copy to .env and fill in your values.
# NEVER commit .env to version control.

# -- App --
# Runtime environment. Controls logging verbosity and FastAPI debug mode.
APP_ENV=development              # development | staging | production
DEBUG=true
LOG_LEVEL=info                   # debug | info | warning | error

# -- PostgreSQL --
# Used by: postgres, backend, worker, keycloak (KC_DB_USERNAME/PASSWORD).
# docker-compose composes DATABASE_URL from these automatically.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres

# -- RustFS (S3-compatible object storage) --
# Used by: rustfs container, backend (boto3), worker, rustfs-init (aws-cli).
# Swap for real AWS credentials to use S3 instead of RustFS.
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin

# -- FastAPI Session --
# Signs the HttpOnly session cookie that holds the OIDC token server-side.
# Must be at least 32 random characters. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET_KEY=change_me_super_secret_key_at_least_32_chars

# -- CORS --
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://app.localhost

# -- Keycloak Admin Console --
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# -- Keycloak OIDC (backend auth) --
# Local dev (default): KEYCLOAK_URL points at the keycloak container.
# Kubeflow integration: override just these two lines, zero code changes:
#   KEYCLOAK_URL=https://auth.your-kubeflow.example.com
#   KEYCLOAK_REALM=kubeflow
# Then register daggle-backend as a new client in Kubeflow's realm.
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=daggle
KEYCLOAK_CLIENT_ID=daggle-backend
KEYCLOAK_CLIENT_SECRET=change_me_keycloak_secret

# -- pgAdmin (devtools profile only) --
# Only active when: docker compose --profile devtools up
PGADMIN_EMAIL=admin@localhost
PGADMIN_PASSWORD=admin
